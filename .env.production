APP_NAME=NeuralFlow
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost
CORS_ALLOW_ORIGINS=*

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
WORKING_MEMORY_MAX_TURNS=10

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=conversation_memory
DOCUMENT_CHROMA_COLLECTION=document_knowledge

POSTGRES_PASSWORD=neuralflow_local_dev_only_change_me
DATABASE_URL=postgresql+psycopg://neuralflow:neuralflow_local_dev_only_change_me@postgres:5432/neuralflow
DOCUMENTS_STORAGE_DIR=/data/uploads

LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_API_BASE=
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
OFFLINE_FALLBACK_ENABLED=true
OLLAMA_FALLBACK_MODEL=

CELERY_WORKER_POOL=solo
MCP_BASE_URL=http://localhost:9000

HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,redis,chroma,postgres,api,worker,frontend
