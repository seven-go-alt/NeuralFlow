APP_NAME=NeuralFlow
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=https://your-domain.com
CORS_ALLOW_ORIGINS=https://your-domain.com

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
WORKING_MEMORY_MAX_TURNS=10

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=conversation_memory
DOCUMENT_CHROMA_COLLECTION=document_knowledge

# 建议生产切 PostgreSQL；如果暂时不切，也至少挂持久卷
DATABASE_URL=postgresql+psycopg://neuralflow:change-me@postgres:5432/neuralflow
DOCUMENTS_STORAGE_DIR=/data/uploads

LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_API_BASE=
LLM_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# 生产建议关闭静默离线兜底，避免错误被掩盖
OFFLINE_FALLBACK_ENABLED=false
OLLAMA_FALLBACK_MODEL=

CELERY_WORKER_POOL=solo
MCP_BASE_URL=http://localhost:9000

# 可选覆盖
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
