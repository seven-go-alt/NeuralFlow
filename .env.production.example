APP_NAME=NeuralFlow
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=https://your-domain.com
CORS_ALLOW_ORIGINS=https://your-domain.com

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
WORKING_MEMORY_MAX_TURNS=10

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=conversation_memory
DOCUMENT_CHROMA_COLLECTION=document_knowledge

POSTGRES_PASSWORD=change-this-to-a-strong-random-password
DATABASE_URL=postgresql+psycopg://neuralflow:change-this-to-a-strong-random-password@postgres:5432/neuralflow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DOCUMENTS_STORAGE_DIR=/data/uploads

LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_API_BASE=
LLM_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

OFFLINE_FALLBACK_ENABLED=false
OLLAMA_FALLBACK_MODEL=

CELERY_WORKER_POOL=solo
MCP_BASE_URL=http://localhost:9000

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,redis,chroma,postgres,api,worker,frontend

# 多模态 RAG（可选，默认关闭）
# MULTIMODAL_ENABLED=true
# VISION_MODEL=gpt-4o

# Optional frontend/browser-facing API base for IP+port testing.
# Example: http://server-ip:20004
NEXT_PUBLIC_API_BASE_URL=

# Optional host port publishing for direct IP+port testing.
FRONTEND_PUBLISHED_PORT=3001
API_PUBLISHED_PORT=8001
