APP_NAME=NeuralFlow
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# 短期记忆：Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
WORKING_MEMORY_MAX_TURNS=10

# 长期记忆：ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=conversation_memory

# 数据存储
DATABASE_URL=sqlite:///./data/neuralflow.db
DOCUMENTS_STORAGE_DIR=data/uploads

# LLM / Chat
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_API_BASE=
LLM_API_KEY=

# Embeddings（建议与 Chat 分开配置，避免代理只支持 chat 不支持 embeddings）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# 生产环境建议关闭离线兜底，避免静默降级
OFFLINE_FALLBACK_ENABLED=true
OLLAMA_FALLBACK_MODEL=

# Worker
CELERY_WORKER_POOL=solo

MCP_BASE_URL=http://localhost:9000

# 可选：如需覆盖默认的 Celery Redis 地址再设置
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth（默认关闭，开启后所有路由需携带 Bearer JWT Token）
# AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_JWT_SECRET=neuralflow-dev-secret-change-in-prod
